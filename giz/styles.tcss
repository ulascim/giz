/* giz - text-only TUI. No boxes, no borders, no highlight colors,
   no padding gymnastics. Just lines of text. */

Screen {
    background: $surface;
    color: $text;
}

#title {
    dock: top;
    height: 1;
    padding: 0 1;
}

#hint {
    dock: bottom;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

/* ---------------- ContactsScreen ---------------- */

#empty {
    height: auto;
    padding: 1;
}

ContactsScreen ListView {
    height: 1fr;
    background: $surface;
    border: none;
}

ContactsScreen ListView > ListItem {
    background: $surface;
    padding: 0 1;
}

ContactsScreen ListView > ListItem.--highlight {
    background: $surface;
    text-style: reverse;
}

.contact-row {
    height: 1;
    layout: horizontal;
    background: transparent;
}

.contact-name {
    width: 1fr;
    background: transparent;
}

.contact-status {
    width: auto;
    background: transparent;
    color: $text-muted;
}

/* ---------------- ChatScreen ---------------- */

ChatScreen RichLog {
    height: 1fr;
    background: $surface;
    border: none;
    padding: 0 1;
    scrollbar-size: 0 0;
}

ChatScreen Input {
    dock: bottom;
    height: 1;
    background: $surface;
    border: none;
    padding: 0 1;
}

/* ---------------- ExchangeLinksScreen ---------------- */

ExchangeLinksScreen #my-pane {
    height: auto;
    padding: 0 1;
}

ExchangeLinksScreen #my-toggle {
    height: 1;
    color: $text-muted;
}

ExchangeLinksScreen #my-link {
    height: auto;
    padding: 1 0;
}

ExchangeLinksScreen #add-pane {
    height: auto;
    padding: 1 1 0 1;
}

ExchangeLinksScreen #add-pane Label {
    height: 1;
    padding: 0;
    color: $text-muted;
}

ExchangeLinksScreen #add-pane Input {
    height: 1;
    background: $surface;
    border: none;
    padding: 0;
    margin: 0 0 1 0;
}

ExchangeLinksScreen #add-status {
    height: auto;
    color: $text-muted;
}
