/* giz - text-only TUI. No boxes, no borders, no highlight colors,
   no padding gymnastics. Just lines of text. */

Screen {
    background: $surface;
    color: $text;
}

#title {
    dock: top;
    height: 1;
    padding: 0 1;
}

#hint {
    dock: bottom;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

/* ---------------- ContactsScreen ---------------- */

#empty {
    height: auto;
    padding: 1;
}

ContactsScreen ListView {
    height: 1fr;
    background: $surface;
    border: none;
}

ContactsScreen ListView > ListItem {
    background: $surface;
    padding: 0 1;
}

/* Unread row indicator. Two-channel cue so the user notices on any
   terminal theme:
     1. A bright-yellow dot is prepended to the contact name in
        screens._contact_item (always visible, even on monochrome
        or low-contrast themes).
     2. A clearly distinct background tint here.

   The previous attempt used $boost, which is perceptually identical
   to $surface on most Textual themes; users reported the unread
   row looked exactly like a normal row. We use $warning at low
   opacity so the row gets a faint warm wash that reads as "new"
   without screaming. The cursor-highlight rule still has higher
   priority because it appears later in the cascade. */
ContactsScreen ListView > ListItem.unread {
    background: $warning 25%;
}
ContactsScreen ListView > ListItem.unread .contact-row,
ContactsScreen ListView > ListItem.unread .contact-name,
ContactsScreen ListView > ListItem.unread .contact-status {
    background: $warning 25%;
}

/* Loud highlight: a solid accent bar across the whole row.
   We have to push the color all the way down to the inner Static
   widgets because they declare 'background: transparent', which
   would otherwise let the row's own background bleed through and
   defeat any reverse/text-style trick. */
ContactsScreen ListView > ListItem.--highlight,
ContactsScreen ListView > ListItem.-highlight,
ContactsScreen ListView:focus > ListItem.--highlight,
ContactsScreen ListView:focus > ListItem.-highlight {
    background: $accent;
    color: $text;
    text-style: bold;
}

ContactsScreen ListView > ListItem.--highlight .contact-row,
ContactsScreen ListView > ListItem.-highlight .contact-row,
ContactsScreen ListView > ListItem.--highlight .contact-name,
ContactsScreen ListView > ListItem.-highlight .contact-name,
ContactsScreen ListView > ListItem.--highlight .contact-status,
ContactsScreen ListView > ListItem.-highlight .contact-status {
    background: $accent;
    color: $text;
    text-style: bold;
}

.contact-row {
    height: 1;
    layout: horizontal;
    background: transparent;
}

.contact-name {
    width: 1fr;
    background: transparent;
}

.contact-status {
    width: auto;
    background: transparent;
    color: $text-muted;
}

/* ---------------- ChatScreen ---------------- */

ChatScreen RichLog {
    height: 1fr;
    background: $surface;
    border: none;
    padding: 0 1;
    scrollbar-size: 0 0;
}

/* The chat screen docks a 2-row container at the bottom: one row
   for the input, one row for the hint. The container is the only
   thing that docks. */
ChatScreen #chat-bottom {
    dock: bottom;
    height: 2;
    background: $surface;
}

/* Make the input row visually distinct so the user can see where
   to type. A flat single-line widget on the same background was
   invisible. */
ChatScreen #chat-bottom Input {
    dock: initial;
    height: 1;
    background: $boost;
    color: $text;
    border: none;
    padding: 0 1;
}

ChatScreen #chat-bottom Input:focus {
    background: $boost;
    color: $text;
    text-style: bold;
}

/* Override the global #hint rule (dock:bottom) so the hint flows
   inside the docked container instead of fighting it. */
ChatScreen #chat-bottom #hint {
    dock: initial;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

/* ---------------- MyLinkScreen ---------------- */

MyLinkScreen #my-link {
    height: auto;
    padding: 1 1;
}

MyLinkScreen #my-status {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

/* ---------------- Shared form-screen styling ---------------- */
/* Single rule for any single-purpose form screen (AddContactScreen,
   RenameContactScreen, etc.). Keeping the look uniform across screens
   matters more than per-screen specificity. */

AddContactScreen Label,
RenameContactScreen Label {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

AddContactScreen Input,
RenameContactScreen Input {
    height: 1;
    background: $surface;
    border: none;
    padding: 0 1;
    margin: 0 0 1 0;
}

AddContactScreen #paste-code,
AddContactScreen #add-status,
RenameContactScreen #rename-status {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

AddContactScreen #paste-code {
    margin: 0 0 1 0;
}

/* ---------------- InfoScreen ---------------- */

InfoScreen #info-scroll {
    height: 1fr;
    background: $surface;
    border: none;
    padding: 0 1;
    scrollbar-size: 1 1;
}

InfoScreen #info-body {
    height: auto;
    padding: 0;
}

/* ---------------- DiagnosticsScreen ---------------- */

DiagnosticsScreen #diag-scroll {
    height: 1fr;
    background: $surface;
    border: none;
    padding: 0 1;
    scrollbar-size: 1 1;
}

DiagnosticsScreen #diag-body {
    height: auto;
    padding: 0;
}
